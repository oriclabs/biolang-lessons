fn test_rmrwr_sample_size() {
    let planned = power_t_test(0.66, 0.05, 0.80)
    let constrained = power_t_test(0.66, 0.05, 0.80, {n: 25})
    assert abs(planned.n_raw - 37.02) < 0.03, "published required n"
    assert 37 + 8 == 45, "published participants per arm"
    assert 2 * 45 == 90, "published total participants"
    assert abs(constrained.power - 0.628) < 0.002, "published fixed-budget power"
}
