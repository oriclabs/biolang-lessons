# Linear discriminant analysis

The source fits `MASS::lda()` to the thirteen unstandardised measurements with cultivar as the group. BioLang does not currently expose a native LDA fitter, so this notebook starts from the two discriminant coefficient vectors printed by the source and independently replays every published downstream calculation. It does not claim to refit the model.

## Exact published discriminant coefficients

```biolang
let variables = ["V2", "V3", "V4", "V5", "V6", "V7", "V8", "V9", "V10", "V11", "V12", "V13", "V14"]
let ld1_coefficients = [-0.403399781, 0.165254596, -0.369075256, 0.154797889, -0.002163496, 0.618052068, -1.661191235, -1.495818440, 0.134092628, 0.355055710, -0.818036073, -1.157559376, -0.002691206]
let ld2_coefficients = [0.8717930699, 0.3053797325, 2.3458497486, -0.1463807654, -0.0004627565, -0.0322128171, -0.4919980543, -1.6309537953, -0.3070875776, 0.2532306865, -1.5156344987, 0.0511839665, 0.0028529846]
table({variable: variables, LD1: ld1_coefficients, LD2: ld2_coefficients})
```

```biolang
fn read_source_wine(path) {
    let data = read_csv(path, {header: false})
    let names = colnames(data)
    data = rename(data, names[0], "V1")
    data = rename(data, names[1], "V2")
    data = rename(data, names[2], "V3")
    data = rename(data, names[3], "V4")
    data = rename(data, names[4], "V5")
    data = rename(data, names[5], "V6")
    data = rename(data, names[6], "V7")
    data = rename(data, names[7], "V8")
    data = rename(data, names[8], "V9")
    data = rename(data, names[9], "V10")
    data = rename(data, names[10], "V11")
    data = rename(data, names[11], "V12")
    data = rename(data, names[12], "V13")
    rename(data, names[13], "V14")
}

let wine = read_source_wine("data/wine.data")
let scored = wine |> mutate("ld1_raw", |row|
    -0.403399781 * row.V2 + 0.165254596 * row.V3 - 0.369075256 * row.V4 +
    0.154797889 * row.V5 - 0.002163496 * row.V6 + 0.618052068 * row.V7 -
    1.661191235 * row.V8 - 1.495818440 * row.V9 + 0.134092628 * row.V10 +
    0.355055710 * row.V11 - 0.818036073 * row.V12 - 1.157559376 * row.V13 -
    0.002691206 * row.V14)
let ld1_center = mean(scored |> col("ld1_raw"))
scored = scored |> mutate("LD1", |row| row.ld1_raw - ld1_center)

scored = scored |> mutate("ld2_raw", |row|
    0.8717930699 * row.V2 + 0.3053797325 * row.V3 + 2.3458497486 * row.V4 -
    0.1463807654 * row.V5 - 0.0004627565 * row.V6 - 0.0322128171 * row.V7 -
    0.4919980543 * row.V8 - 1.6309537953 * row.V9 - 0.3070875776 * row.V10 +
    0.2532306865 * row.V11 - 1.5156344987 * row.V12 + 0.0511839665 * row.V13 +
    0.0028529846 * row.V14)
let ld2_center = mean(scored |> col("ld2_raw"))
scored = scored |> mutate("LD2", |row| row.ld2_raw - ld2_center)
scored |> select("V1", "LD1", "LD2") |> head(12)
```

The first six LD1 values reproduce the source's -4.70024401, -4.30195811, -3.42071952, -4.20575366, -1.50998168, and -4.51868934 to the precision available from its printed coefficients.

## Separation achieved

```biolang
fn within_group_variance(data, variable) {
    let g1 = data |> filter(|row| row.V1 == 1) |> col(variable)
    let g2 = data |> filter(|row| row.V1 == 2) |> col(variable)
    let g3 = data |> filter(|row| row.V1 == 3) |> col(variable)
    ((len(g1) - 1) * variance(g1) + (len(g2) - 1) * variance(g2) + (len(g3) - 1) * variance(g3)) / (nrow(data) - 3)
}

fn between_group_variance(data, variable) {
    let values = data |> col(variable)
    let grand_mean = mean(values)
    let g1 = data |> filter(|row| row.V1 == 1) |> col(variable)
    let g2 = data |> filter(|row| row.V1 == 2) |> col(variable)
    let g3 = data |> filter(|row| row.V1 == 3) |> col(variable)
    (len(g1) * (mean(g1) - grand_mean) ** 2 + len(g2) * (mean(g2) - grand_mean) ** 2 + len(g3) * (mean(g3) - grand_mean) ** 2) / 2
}

let ld1_groups = [1, 2, 3] |> map(|group| mean(scored |> filter(|row| row.V1 == group) |> col("LD1")))
let ld2_groups = [1, 2, 3] |> map(|group| mean(scored |> filter(|row| row.V1 == group) |> col("LD2")))
let ld1_separation = between_group_variance(scored, "LD1") / within_group_variance(scored, "LD1")
let ld2_separation = between_group_variance(scored, "LD2") / within_group_variance(scored, "LD2")
{
    LD1_group_means: ld1_groups,
    LD2_group_means: ld2_groups,
    LD1_separation: ld1_separation,
    LD2_separation: ld2_separation
}
```

The source reports separations 794.6522 and 361.2410, so LD1 accounts for 68.75% and LD2 for 31.25% of the total discriminating separation.

