# 8.4 Discrete variables

This notebook directly ports the contingency-table and logistic-regression sequence in section 8.4 of [*Biological Data Science with R*, Essential statistics](https://bdsr.stephenturner.us/stats.html).

```biolang
let nh = read_csv("nhanes.csv")
let adults = nh |> filter(|row| row.Age >= 18)
```

## 8.4.1 Contingency tables

> **Understanding categorical association tests**
>
> **Use them when:** both variables are categories and each independent observation contributes to one table cell.
>
> **How to read them:** chi-square compares observed with independence-expected counts; Fisher's exact test is useful for sparse 2x2 tables. Pair the p-value with proportions or an effect estimate because evidence strength is not effect size.

The gender-by-diabetes table uses the source's row and column order. The second table adds the same marginal totals shown by `addmargins()`.

```biolang
let gender_diabetes_rows = adults |> drop_null("Gender") |> drop_null("Diabetes")
let gender_diabetes = gender_diabetes_rows |> cross_tab(
    "Gender", "Diabetes",
    {row_order: ["female", "male"], col_order: ["No", "Yes"]}
)
let gd_no = gender_diabetes |> col("No")
let gd_yes = gender_diabetes |> col("Yes")
let gd_total = sum(gd_no) + sum(gd_yes)
let gender_diabetes_margins = table({
    Gender: ["female", "male", "Sum"],
    No: [gd_no[0], gd_no[1], sum(gd_no)],
    Yes: [gd_yes[0], gd_yes[1], sum(gd_yes)],
    Sum: [gd_no[0] + gd_yes[0], gd_no[1] + gd_yes[1], gd_total]
})
{counts: gender_diabetes, with_margins: gender_diabetes_margins}
```

```biolang
let gender_diabetes_total_proportions = table({
    Gender: ["female", "male"],
    No: [gd_no[0] / gd_total, gd_no[1] / gd_total],
    Yes: [gd_yes[0] / gd_total, gd_yes[1] / gd_total]
})
let gender_diabetes_row_proportions = table({
    Gender: ["female", "male"],
    No: [gd_no[0] / (gd_no[0] + gd_yes[0]), gd_no[1] / (gd_no[1] + gd_yes[1])],
    Yes: [gd_yes[0] / (gd_no[0] + gd_yes[0]), gd_yes[1] / (gd_no[1] + gd_yes[1])]
})
{overall_proportions: gender_diabetes_total_proportions, row_proportions: gender_diabetes_row_proportions}
```

```biolang
let gender_diabetes_chi = chi_square_contingency(gender_diabetes |> drop_cols("Gender"))
let gender_diabetes_fisher = fisher_exact(gd_no[0], gd_yes[0], gd_no[1], gd_yes[1])
{chi_square: gender_diabetes_chi, fisher_exact: gender_diabetes_fisher}
```

The source calls unshaded base-R `mosaicplot(xt, main=NA)`. BioLang preserves its count-area geometry, category order, inter-cell gaps, outer labels, and no-title layout, while using distinct column colours so the diabetes categories remain visually identifiable in Studio.

```biolang
mosaic_plot(gender_diabetes, {
    row: "Gender", layout: "base", title: "", subtitle: "",
    x_label: "Gender", y_label: "Diabetes", shade: "column",
    show_values: false, width: 840, height: 600, format: "svg"
})
```

The race-by-insurance workflow repeats the same table, row-proportion, chi-square, expected-count, and mosaic sequence.

```biolang
let race_order = ["Asian", "Black", "Hispanic", "Mexican", "Other", "White"]
let race_insured_rows = adults |> drop_null("Race") |> drop_null("Insured")
let race_insured = race_insured_rows |> cross_tab(
    "Race", "Insured", {row_order: race_order, col_order: ["No", "Yes"]}
)
let ri_no = race_insured |> col("No")
let ri_yes = race_insured |> col("Yes")
let race_insured_margins = table({
    Race: ["Asian", "Black", "Hispanic", "Mexican", "Other", "White", "Sum"],
    No: [ri_no[0], ri_no[1], ri_no[2], ri_no[3], ri_no[4], ri_no[5], sum(ri_no)],
    Yes: [ri_yes[0], ri_yes[1], ri_yes[2], ri_yes[3], ri_yes[4], ri_yes[5], sum(ri_yes)],
    Sum: [
        ri_no[0] + ri_yes[0], ri_no[1] + ri_yes[1], ri_no[2] + ri_yes[2],
        ri_no[3] + ri_yes[3], ri_no[4] + ri_yes[4], ri_no[5] + ri_yes[5],
        sum(ri_no) + sum(ri_yes)
    ]
})
race_insured_margins
```

```biolang
let race_insured_row_proportions = table({
    Race: race_order,
    No: [
        ri_no[0] / (ri_no[0] + ri_yes[0]), ri_no[1] / (ri_no[1] + ri_yes[1]),
        ri_no[2] / (ri_no[2] + ri_yes[2]), ri_no[3] / (ri_no[3] + ri_yes[3]),
        ri_no[4] / (ri_no[4] + ri_yes[4]), ri_no[5] / (ri_no[5] + ri_yes[5])
    ],
    Yes: [
        ri_yes[0] / (ri_no[0] + ri_yes[0]), ri_yes[1] / (ri_no[1] + ri_yes[1]),
        ri_yes[2] / (ri_no[2] + ri_yes[2]), ri_yes[3] / (ri_no[3] + ri_yes[3]),
        ri_yes[4] / (ri_no[4] + ri_yes[4]), ri_yes[5] / (ri_no[5] + ri_yes[5])
    ]
})
let race_insurance_chi = chi_square_contingency(race_insured |> drop_cols("Race"))
{row_proportions: race_insured_row_proportions, chi_square: race_insurance_chi, expected: race_insurance_chi.expected}
```

```biolang
mosaic_plot(race_insured, {
    row: "Race", layout: "base", title: "", subtitle: "",
    x_label: "Race", y_label: "Insured", shade: "column",
    show_values: false, width: 960, height: 600, format: "svg"
})
```

## 8.4.2 Logistic regression

> **Understanding logistic regression**
>
> **Use it when:** the outcome has two categories and you need prediction or adjusted associations from several predictors.
>
> **How to read it:** coefficients are changes in log odds; exponentiating gives odds ratios conditional on the other model terms. Check calibration, separation, functional form, and whether an odds ratio answers the practical question.

The source explicitly releveled race so White is the reference. BioLang uses a stable sort key to put the White level first, then preserves the source factor order for the remaining levels. Sorting rows does not alter the likelihood; it only pins the treatment-contrast baseline.

```biolang
let race_model_rows = adults
    |> mutate("RaceOrder", |row|
        if row.Race == "White" { 0 }
        else if row.Race == "Asian" { 1 }
        else if row.Race == "Black" { 2 }
        else if row.Race == "Hispanic" { 3 }
        else if row.Race == "Mexican" { 4 }
        else if row.Race == "Other" { 5 }
        else { 6 }
    )
    |> arrange("RaceOrder")
let insured = race_model_rows |> col("Insured")
    |> map(|value| if value == "Yes" { 1 } else if value == "No" { 0 } else { nil })
let insured_by_race = stats_glm_diagnostics(
    table({Race: race_model_rows |> col("Race")}), insured,
    {family: "binomial", include_values: false}
)
insured_by_race.coefficients
```

```biolang
let insured_adjusted = stats_glm_diagnostics(
    table({
        Age: race_model_rows |> col("Age"),
        Income: race_model_rows |> col("Income"),
        SleepHrsNight: race_model_rows |> col("SleepHrsNight"),
        Race: race_model_rows |> col("Race")
    }), insured,
    {family: "binomial", include_values: false}
)
insured_adjusted.coefficients
```

```biolang
assert gd_no[0] == 1692 && gd_yes[0] == 164 && gd_no[1] == 1653 && gd_yes[1] == 198, "source gender-diabetes counts"
assert abs(gender_diabetes_chi.chi2 - 3.433238629121743) < 0.000000001, "source Yates chi-square"
assert abs(gender_diabetes_fisher.p_value - 0.05992352432232489) < 0.000000000001, "source Fisher p-value"
assert ri_no == [46, 86, 89, 147, 33, 307], "source uninsured counts"
assert ri_yes == [169, 330, 151, 141, 65, 2141], "source insured counts"
assert abs(race_insurance_chi.chi2 - 323.3016487345038) < 0.000000001, "source race-insurance chi-square"
assert abs(race_insurance_chi.p_value - 9.754237575941022e-68) / 9.754237575941022e-68 < 0.000000001, "source race-insurance p-value"
assert insured_by_race.encodings[0].reference == "White", "source White race baseline"
assert abs(insured_by_race.coefficients[0].estimate - 1.9421805410025388) < 0.000000001, "source race-only intercept"
assert abs(insured_by_race.coefficients[1].estimate - -0.6409232225685543) < 0.000000001, "source Asian coefficient"
assert abs(insured_adjusted.coefficients[0].estimate - -0.350140855485075) < 0.000000001, "source adjusted intercept"
assert abs(insured_adjusted.coefficients[3].estimate - -0.4550403000469768) < 0.000000001, "source adjusted Asian coefficient"
"Exact source tables, models, and runtime figures passed."
```

