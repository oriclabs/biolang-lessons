fn test_beyondmlr_birdkeeping_reference_parity() {
    let birds = read_csv("../data/birdkeeping.csv")
    let a = birds |> filter(|row| row.bird == 1 && row.cancer == 1) |> nrow()
    let b = birds |> filter(|row| row.bird == 1 && row.cancer == 0) |> nrow()
    let c = birds |> filter(|row| row.bird == 0 && row.cancer == 1) |> nrow()
    let d = birds |> filter(|row| row.bird == 0 && row.cancer == 0) |> nrow()
    let unadjusted_or = (1.0 * a * d) / (b * c)
    let model4 = glm(~cancer ~ (yrsmoke + bird), birds, "binomial")

    assert nrow(birds) == 147, "exact source rows"
    assert a == 33 && b == 34 && c == 16 && d == 64, "exact 2x2 table"
    assert abs(unadjusted_or - 3.8823529411764706) < 1e-12, "unadjusted odds ratio"
    assert model4.converged, "model convergence"
    assert abs(model4.coefficients[0] - -3.180155446359459) < 1e-10, "intercept"
    assert abs(model4.coefficients[1] - 0.05824972355555551) < 1e-10, "years smoked"
    assert abs(model4.coefficients[2] - 1.4755515107867647) < 1e-10, "birdkeeping"
}
