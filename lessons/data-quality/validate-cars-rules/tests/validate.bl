fn test_validate_cars_reference_parity() {
    let cars = read_csv("../data/cars.csv")
    let v1 = cars |> filter(|row| row.speed >= 0) |> nrow()
    let v2 = cars |> filter(|row| row.dist >= 0) |> nrow()
    let v3 = cars |> filter(|row| 1.0 * row.speed / row.dist <= 1.5) |> nrow()
    let correlation = cor(cars |> col("speed"), cars |> col("dist"))
    let violating = cars |> filter(|row| 1.0 * row.speed / row.dist > 1.5)

    assert nrow(cars) == 50 && ncol(cars) == 3, "exact source data"
    assert v1 == 50 && v2 == 50 && v3 == 48, "exact row-rule counts"
    assert correlation >= 0.2, "aggregate rule passes"
    assert abs(correlation - 0.8068949006892104) < 1e-12, "exact correlation"
    assert violating |> col("rownames") == [1, 3], "exact violating records"
}
